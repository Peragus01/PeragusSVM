{
  "name": "@peragus/backend",
  "version": "0.1.0",
  "description": "Peragus settlement orchestration backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev",
    "db:migrate": "node scripts/migrate.mjs",
    "demo:pix-expiry:prepare": "node scripts/ozav-pix-expiry-demo.mjs prepare",
    "demo:pix-expiry:watch": "node scripts/ozav-pix-expiry-demo.mjs watch",
    "demo:pix-success": "node scripts/ozav-pix-expiry-demo.mjs success",
    "demo:settlement:advance": "node scripts/ozav-pix-expiry-demo.mjs advance",
    "demo:offramp": "node scripts/ozav-pix-expiry-demo.mjs offramp",
    "demo:audit": "node scripts/settlement-audit-demo.mjs",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@fastify/sensible": "^6.0.6",
    "@solana/web3.js": "^1.99.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
