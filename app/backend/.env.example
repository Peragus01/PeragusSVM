NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Enable on API only after migration 032 (60 reads / 10 writes per user/minute).
API_RATE_LIMITS_ENABLED=false
SANDBOX_WITHDRAWAL_CLOSURE_ENABLED=false
PERAGUS_SANDBOX_DEMO_ENABLED=false
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false
SOLANA_RPC_URL=http://127.0.0.1:18899
SOLANA_PROGRAM_ID=6Auy8BXWNaWQCAEbDkusoDkAjWvyzhkKw2LbfiVvvb1w
SOLANA_COSIGNING_ENABLED=false
SOLANA_CONTINGENCY_RESERVE_ENABLED=false
SOLANA_CONTINGENCY_FALLBACK_SECONDS=300
JOB_POLL_INTERVAL_SECONDS=2
JOB_CONCURRENCY=3
OZAV_ONRAMP_WRITES_ENABLED=false
OZAV_OFFRAMP_WRITES_ENABLED=false
OZAV_SOURCE_DECIMALS=6
OZAV_SPREAD_BPS=0
OZAV_MIN_SOURCE_AMOUNT_BRL=400
OZAV_RECONCILIATION_INTERVAL_SECONDS=30
OZAV_RECONCILIATION_MAX_ATTEMPTS=120
# Configure somente no .env local:
# OZAV_API_KEY=ozav_sk_test_SUBSTITUA
# OZAV_CUSTOMER_ID=ozav_cus_SUBSTITUA
# OZAV_WALLET_ID=ozav_wal_SUBSTITUA
# Configure caminhos somente no .env local para testes de coassinatura:
# SOLANA_SOURCE_MINT=SUBSTITUA
# SOLANA_DESTINATION_MINT=SUBSTITUA
# SOLANA_ATTESTATION_KEYPAIR_PATH=/caminho/absoluto/attestation.json
# SOLANA_LIQUIDITY_KEYPAIR_PATH=/caminho/absoluto/liquidity.json
# SOLANA_FEE_PAYER_KEYPAIR_PATH=/caminho/absoluto/fee-payer.json
# Em hospedagem, use variáveis secretas seladas em base64 no lugar dos caminhos:
# SOLANA_ATTESTATION_KEYPAIR_BASE64=SUBSTITUA
# SOLANA_LIQUIDITY_KEYPAIR_BASE64=SUBSTITUA
# SOLANA_FEE_PAYER_KEYPAIR_BASE64=SUBSTITUA

# Optional 32-byte hex HMAC key for email-bound registration invites (API only).
# Keep stable; changing it invalidates unredeemed email-bound invitations.
# PILOT_INVITE_EMAIL_HASH_KEY=

# Test-only onboarding notifications; dedicated start:onboarding-emails service.
# ONBOARDING_EMAILS_ENABLED=false
# RESEND_API_KEY=re_REPLACE
# RESEND_FROM=noreply@peragus.com.br
# ONBOARDING_EMAIL_ACCOUNT_URL=https://YOUR-STAGING.vercel.app/app/minha-conta
# ONBOARDING_EMAIL_TEST_USER_IDS=CONSENTING_STAGING_AUTH_USER_UUID

# Document upload implementation: disabled; synthetic staging acceptance only.
CUSTOMER_DOCUMENTS_ENABLED=false
CUSTOMER_DOCUMENT_UPLOAD_ORIGINS=

# Required legal documents (version + SHA-256 of the exact published HTML bytes).
# Must equal docs/operations/legal-required-documents.json; enforced by test/legal-documents-hash.test.ts.
# Changing a version or hash makes every customer re-accept (LEGAL_ACCEPTANCE_REQUIRED).
LEGAL_REQUIRED_DOCUMENTS={"terms":{"version":"draft-0.9-2026-11-03","sha256":"878835648a716afec9ed2834e9c04b0d312d2c562128c93f24ec938063e4a451"},"privacy":{"version":"draft-0.9-2026-11-03","sha256":"6539cbeb8f1ca83f29148f5913624fcb0a72641e7bc5a8a2901f1f230cab3ed3"},"refund":{"version":"2026-11-02","sha256":"73d84a9678e3b2ef98b67be11c94a78a6b14a6ac47fe931fbce774aa3478ca57"}}
